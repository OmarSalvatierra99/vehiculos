FLASK_ENV=development
HOST=0.0.0.0
PORT=5010
DEBUG=true
SECRET_KEY=change-this-secret
LOG_LEVEL=INFO
LOG_FILE=log/app.log
INVENTARIOS_DB=inventarios.db
CATALOGOS_DIR=catalogos

# SSO compartido entre subdominios del portafolio.
PORTFOLIO_SSO_SECRET=change-this-shared-sso-secret
PORTFOLIO_SSO_COOKIE_NAME=portfolio_sso
PORTFOLIO_SSO_COOKIE_DOMAIN=.omar-xyz.shop
PORTFOLIO_SSO_MAX_AGE_SECONDS=43200
